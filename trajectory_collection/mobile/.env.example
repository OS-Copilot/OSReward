# Copy this file to `.env` at this directory's root and fill in your values.
# `.env` holds live credentials -- it is gitignored, do not commit it.
# Every variable here backs a flag of the same (lowercase) name in run.py, so
# a command-line flag always overrides it.

# ---------------------------------------------------------------- Android SDK
# Used to auto-detect `adb`. macOS default: ~/Library/Android/sdk
# Windows: use forward slashes (/) or double backslashes (\\).
# ANDROID_HOME="C:/Users/<user-name>/AppData/Local/Android/Sdk"

# ------------------------------------------------------------ Collection model
# MODEL_NAME must appear in MODEL_TO_PROFILE in
# android_world/agents/model_profiles.py, or the run fails at startup before
# the emulator is touched. Currently supported:
#   qwen3-vl-235b-a22b-instruct
#   gemini-3-pro-preview
#   gemini-3-flash-preview
#   gemini-3-flash
# For anything else, set MODEL_PROFILE (qwen3vl | gemini3) explicitly.

MODEL_NAME="gemini-3-pro-preview"
MODEL_BASE_URL="https://your-endpoint/v1"
MODEL_API_KEY="your-key-here"
# MODEL_PROFILE="gemini3"

# ------------------------------------------------------------------ Task suite
# Which task set `--suite_family=android_world_extension` serves:
#   aw       131 verified AndroidWorld extension tasks (default)
#   new_app  115 new-app tasks (Chrome / Gmail / Maps / YouTube / Yahoo Finance)
# EXT_SUITE="aw"

# --------------------------------------------------------------------- Windows
# The run summary prints emoji; without this the default GBK console codec
# raises UnicodeEncodeError after the first task completes.
# PYTHONIOENCODING="utf-8"
