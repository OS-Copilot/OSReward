# Copy to .env and fill in. Auto-loaded at import time.

# OpenAI-compatible judge endpoint (required)
MODEL_REQUEST_URL=https://your-endpoint/v1
API_KEY=sk-your-key-here

# Optional: several keys for higher throughput (comma-separated; each is its own
# concurrent channel and overrides API_KEY).
# API_KEYS=sk-key1,sk-key2,sk-key3

# Optional: dataset + output root (default: ./data)
# OOD_DATA_ROOT=/abs/path/to/data

# Concurrency caps
MAX_CONCURRENCY_PER_KEY=6
GLOBAL_MAX_CONCURRENCY=16
